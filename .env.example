# ── Shared / Anthropic ──
# ANTHROPIC_API_KEY is only used by the Slack bot (src/slack-bot). Samantha and
# Mila now run on Cloud Run and authenticate to Claude via Vertex AI using the
# runtime service account's identity — no key needed for them.
ANTHROPIC_API_KEY=sk-ant-your-key
SAMANTHA_GOOGLE_WORKSPACE_EMAIL=samantha@norcalcarbmobile.com

# ── Slack Bot ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Comma-separated Slack member IDs allowed to invoke slash commands.
ALLOWED_USER_IDS=U01ABC123DEF
SLACK_MAX_CONCURRENT_MISSIONS=2
SLACK_DAILY_TOKEN_BUDGET=60000
SLACK_MISSION_TOKEN_WARN_THRESHOLD=12000
# Max agents that may run inside a single /swarm dispatch.
SLACK_SWARM_MAX_AGENTS=8
# How many swarm agents may hit the Anthropic API in parallel.
SLACK_SWARM_PARALLELISM=3
# Cloud Run URL for the Samantha service. When set, DMs and @mentions to
# the Slack bot route to her instead of doing nothing — gives you a
# continuous voice-friendly conversation via Slack mobile voice memos.
# Leave blank to disable DM mode (slash commands still work).
SAMANTHA_URL=

# ── Samantha (Cloud Run + Vertex AI Claude) ──
# Samantha authenticates via Google Application Default Credentials. For local
# dev, run `gcloud auth application-default login` first, then set:
PORT=8080
ANTHROPIC_VERTEX_PROJECT_ID=samantha
CLOUD_ML_REGION=us-east5
# SAMANTHA_MODEL=claude-haiku-4-5@20251001
# SAMANTHA_MAX_TOKENS=1024
# SAMANTHA_ALLOWED_ORIGINS=http://localhost:8080
# Shared secret. Callers must send this in the `x-samantha-token` header to
# unlock the full /api/samantha/status payload; anonymous callers only see
# `{ ready, timestamp }`. Generate with `openssl rand -hex 32`.
SAMANTHA_STATUS_TOKEN=

# ── Mila Chatbot (Cloud Run + Vertex AI Claude) ──
# Like Samantha, Mila uses Google Application Default Credentials. For local
# dev, run `gcloud auth application-default login` first. ANTHROPIC_VERTEX_PROJECT_ID
# and CLOUD_ML_REGION above are reused.
MILA_PORT=3001
# Shared secret. Callers must send this in the `x-mila-token` header to
# unlock the full /tps payload (leads, sessions); anonymous callers only see
# `{ status, agent, timestamp }`. Generate with `openssl rand -hex 32`.
MILA_STATUS_TOKEN=
# Leave blank to allow any origin during local development.
MILA_ALLOWED_ORIGINS=http://localhost:3001
MILA_MAX_MESSAGE_CHARS=2000
MILA_SESSION_HISTORY_LIMIT=20
MILA_SESSION_TTL_MINUTES=720
MILA_MAX_ACTIVE_SESSIONS=200
MILA_LEAD_RETENTION_LIMIT=200
# MILA_MODEL=claude-haiku-4-5@20251001
# MILA_MAX_TOKENS=1024

# ── CRM ──
# Google Sheet ID for the Master CRM. Used by agents (A+ Hunter, DataSync).
CRM_SHEET_ID=your-crm-sheet-id

# ── Google Lead Scraper ──
GOOGLE_PLACES_API_KEY=your-google-places-key
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json
SCRAPER_REQUEST_RETRIES=3
SCRAPER_REQUEST_DELAY_MS=200
