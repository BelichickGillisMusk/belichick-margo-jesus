# ── Slack Bot ──
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Google ──
GOOGLE_PLACES_API_KEY=your-google-places-key
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_KEY=./google-service-account.json

# ── Server ──
MILA_PORT=3001

# ── Authorized Slack Users (allowlist) ──
# Comma-separated Slack user IDs (e.g. U01ABC123DEF). Only these users can run bot commands.
# Find your user ID: click your profile in Slack → View full profile → More → Copy member ID
CLAUDE_USER_ID=U01ABC123DEF
ALLOWED_USER_IDS=U01ABC123DEF
