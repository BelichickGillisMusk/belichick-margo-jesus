name = "cleantruckcheck-fairfield"
main = "src/index.ts"
compatibility_date = "2026-04-01"

routes = [
  { pattern = "cleantruckcheckfairfield.com/*", zone_name = "cleantruckcheckfairfield.com" },
  { pattern = "www.cleantruckcheckfairfield.com/*", zone_name = "cleantruckcheckfairfield.com" },
]

# TODO(deploy): replace `id` with Fairfield's isolated KV namespace.
# Create one if it does not exist:
#   wrangler kv namespace create FAIRFIELD_HTML_STORE
# Then paste the returned id below. Do NOT bind to the shared HTML_STORE.
[[kv_namespaces]]
binding = "FAIRFIELD_HTML_STORE"
id      = "REPLACE_WITH_FAIRFIELD_KV_ID"

[[d1_databases]]
binding       = "LEADS_DB"
database_name = "norcal-carb-leads"
database_id   = "ded9f851-2944-4f66-97de-e88c6b7bd9c9"

[[r2_buckets]]
binding     = "FORM_SUBMISSIONS"
bucket_name = "form-submissions"
